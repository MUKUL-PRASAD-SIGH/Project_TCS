{
  "schema_version": "2.0",
  "disclaimer": "SYNTHETIC DEMO RULES — NOT GOVERNMENT REGULATIONS.",
  "permits": [
    {
      "id": "temporary_event",
      "name": "Temporary Event",
      "description": "Synthetic pre-check for a short-duration public event.",
      "jurisdiction_ids": ["in-ka-bengaluru-demo"],
      "keywords": ["event", "festival", "concert", "college fest", "gathering"],
      "questions": [
        {"field": "event_duration_days", "label": "How many days will the event run?", "help_text": "Include setup days only if the activity is open to attendees.", "input_type": "number"},
        {"field": "expected_attendance", "label": "What is the maximum expected attendance?", "input_type": "number"},
        {"field": "emergency_plan_status", "label": "Do you have an emergency plan?", "input_type": "select", "document": true, "options": [{"value": "have", "label": "Yes, self-reported"}, {"value": "missing", "label": "No"}, {"value": "unknown", "label": "Not sure"}]},
        {"field": "venue_permission_status", "label": "Do you have venue-owner permission?", "input_type": "select", "document": true, "options": [{"value": "have", "label": "Yes, self-reported"}, {"value": "missing", "label": "No"}, {"value": "unknown", "label": "Not sure"}]},
        {"field": "uses_amplified_sound", "label": "Will the event use amplified sound?", "input_type": "boolean"},
        {"field": "amplified_sound_end_hour", "label": "At what hour will amplified sound end?", "help_text": "Use a 24-hour whole number, for example 21 for 9 PM.", "input_type": "number", "show_when": {"field": "uses_amplified_sound", "operator": "equals", "value": true}},
        {"field": "serves_food", "label": "Will food be served or sold?", "input_type": "boolean"},
        {"field": "food_safety_plan_status", "label": "Do you have a food-safety plan?", "input_type": "select", "document": true, "options": [{"value": "have", "label": "Yes, self-reported"}, {"value": "missing", "label": "No"}, {"value": "unknown", "label": "Not sure"}], "show_when": {"field": "serves_food", "operator": "equals", "value": true}}
      ]
    },
    {
      "id": "temporary_food_stall",
      "name": "Temporary Food Stall",
      "description": "Synthetic pre-check for a temporary food stall at an event.",
      "jurisdiction_ids": ["in-ka-bengaluru-demo"],
      "keywords": ["food stall", "food booth", "temporary kitchen", "sell food", "canteen stall"],
      "questions": [
        {"field": "operating_days", "label": "How many days will the stall operate?", "input_type": "number"},
        {"field": "food_handlers_trained", "label": "Have all food handlers completed food-safety training?", "input_type": "boolean"},
        {"field": "handwashing_facility_available", "label": "Will a handwashing facility be available?", "input_type": "boolean"},
        {"field": "registration_proof_status", "label": "Do you have the demo registration proof?", "input_type": "select", "document": true, "options": [{"value": "have", "label": "Yes, self-reported"}, {"value": "missing", "label": "No"}, {"value": "unknown", "label": "Not sure"}]},
        {"field": "uses_lpg", "label": "Will the stall use LPG?", "input_type": "boolean"},
        {"field": "uses_open_flame", "label": "Will the stall use any other open flame?", "input_type": "boolean"},
        {"field": "fire_extinguisher_available", "label": "Will a suitable fire extinguisher be available?", "input_type": "boolean", "show_when": {"any": [{"field": "uses_lpg", "operator": "equals", "value": true}, {"field": "uses_open_flame", "operator": "equals", "value": true}]}},
        {"field": "serves_perishables", "label": "Will the stall serve perishable food?", "input_type": "boolean"},
        {"field": "cold_storage_available", "label": "Will suitable cold storage be available?", "input_type": "boolean", "show_when": {"field": "serves_perishables", "operator": "equals", "value": true}}
      ]
    }
  ]
}
